{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/json-consistency-repair/primary-factorization-v1.schema.json",
  "title": "JSON Consistency Repair Primary Factorization v1",
  "type": "object",
  "required": ["contract", "partition_rule", "option_count", "primary_block_count", "blocks", "recomposition_proof", "factorization_sha256"],
  "properties": {
    "contract": {"const": "json-consistency-repair.primary-factorization.v1"},
    "partition_rule": {"const": "CONCRETE_RELATION_CONNECTED_COMPONENTS"},
    "option_count": {"type": "integer", "minimum": 0},
    "primary_block_count": {"type": "integer", "minimum": 0},
    "legacy_parent_block_count": {"type": "integer", "minimum": 0},
    "strict_refinement_of_legacy_parent_partition": {"type": "boolean"},
    "cross_parent_relation_merge_present": {"type": "boolean"},
    "guarded_legacy_carriers": {"type": "array", "items": {"type": "string"}},
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["block_id", "option_ids", "paths", "option_count", "primary"],
        "properties": {
          "block_id": {"type": "string"},
          "option_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "candidate_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "relation_bindings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "option_count": {"type": "integer", "minimum": 0},
          "primary": {"const": true}
        },
        "additionalProperties": true
      }
    },
    "primary_relation_registry": {"type": "array", "items": {"type": "object"}},
    "coupling_edges": {"type": "array", "items": {"type": "object"}},
    "recomposition_proof": {
      "type": "object",
      "required": ["frontier_option_count", "covered_option_count", "unique_coverage", "cross_block_dependency_edge_count", "information_loss", "lossless"],
      "properties": {
        "frontier_option_count": {"type": "integer", "minimum": 0},
        "covered_option_count": {"type": "integer", "minimum": 0},
        "unique_coverage": {"const": true},
        "cross_block_dependency_edge_count": {"const": 0},
        "information_loss": {"const": 0},
        "lossless": {"const": true}
      },
      "additionalProperties": false
    },
    "factorization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
