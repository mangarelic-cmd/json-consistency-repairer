{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/json-consistency-repair/open-obligation-wake-plan-v1.schema.json",
  "title": "PASS038 OPEN obligation wake plan",
  "type":"object",
