{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "json-consistency-repair.final-certifier.v1",
  "type": "object",
  "required": [
    "contract",
    "status",
    "ok",
    "checks",
    "certifier_code_sha256"
  ],
  "properties": {
    "contract": {
      "const": "json-consistency-repair.final-certifier.v1"
    },
    "status": {
      "enum": [
        "CERTIFIED",
        "REJECTED"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "checks": {
      "type": "object"
    },
    "certifier_code_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance_root": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
