{
  "$defs": {
    "authorityScope": {
      "additionalProperties": true,
      "properties": {
        "document": {
          "type": "string"
        },
        "documents": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "operations": {
          "items": {
            "enum": [
              "add",
              "replace",
              "witness",
              "project",
              "default",
              "*"
