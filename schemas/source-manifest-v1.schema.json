            "maxItems": 256,
            "minItems": 2,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "source_ids"
        ],
        "type": "object"
      },
      "maxItems": 1024,
      "type": "array"
    },
    "sources": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "authority_scope": {
            "oneOf": [
              {
                "$ref": "#/$defs/authorityScope"
              },
              {
                "items": {
                  "$ref": "#/$defs/authorityScope"
