            "type": "string"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "path": {
          "type": "string"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "schema_version": {
          "type": [
            "string",
            "number"
          ]
        },
        "schema_versions": {
          "items": {
            "type": [
              "string",
              "number"
            ]
          },
          "maxItems": 256,
          "type": "array"
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$id": "https://json-consistency-repair.local/source-manifest-v1.schema.json",
