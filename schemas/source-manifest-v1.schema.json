            "classification": {
              "enum": [
                "SOURCE_EXACT",
                "DERIVED_EXACT",
                "USER_DECLARED",
                "INFERRED",
                "UNVERIFIED_ATTRIBUTION"
              ]
            },
            "pointer": {
              "type": "string"
            },
            "rule_id": {
              "minLength": 1,
              "type": "string"
            },
            "source_id": {
              "minLength": 1,
              "type": "string"
            },
            "source_pointer": {
              "type": "string"
            },
            "template": {}
          },
          "required": [
            "classification"
          ],
          "type": "object"
        },
        {
          "items": {
            "oneOf": [
              {
                "additionalProperties": true,
                "properties": {
                  "claim_id": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "classification": {
                    "enum": [
                      "SOURCE_EXACT",
                      "DERIVED_EXACT",
                      "USER_DECLARED",
                      "INFERRED",
                      "UNVERIFIED_ATTRIBUTION"
                    ]
                  },
                  "pointer": {
                    "type": "string"
                  },
                  "rule_id": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "source_id": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "source_pointer": {
                    "type": "string"
                  },
                  "template": {}
                },
                "required": [
                  "classification"
                ],
                "type": "object"
              }
            ]
          },
          "maxItems": 1024,
          "type": "array"
        }
      ]
    },
    "source_correlations": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "correlation_id": {
            "type": [
              "string",
              "number"
