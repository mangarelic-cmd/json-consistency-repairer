{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "json-consistency-repair.report.v1",
  "type": "object",
  "required": ["engine", "version", "report_contract", "provenance", "input_digest", "output_digest", "cycles", "remaining_issues", "replay"],
  "properties": {
    "engine": {"const": "json-consistency-repair"},
    "version": {"type": "string"},
    "report_contract": {
      "type": "object",
      "required": ["name", "schema_version", "status", "status_exit_code"],
      "properties": {
        "name": {"const": "json-consistency-repair.report.v1"},
        "schema_version": {"const": "1.0"},
        "status": {"type": "string"},
        "status_exit_code": {"type": ["integer", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["package", "version", "package_code_sha256"],
      "properties": {
        "package": {"const": "json-consistency-repair"},
        "version": {"type": "string"},
        "package_code_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "input_digest": {"type": "string"},
    "output_digest": {"type": "string"},
    "cycles": {"type": "array"},
    "remaining_issues": {},
    "replay": {"type": "object"}
  }
}
